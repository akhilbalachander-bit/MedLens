# ---------------------------------------------------------------
# MedLens configuration. Copy to .env.local and fill in.
# Without any key, MedLens still runs: the sample document and all
# tools work using built-in fictional sample data.
# ---------------------------------------------------------------

# Which provider to use: "gemini", "openai", or "mock" (dev only — returns
# the fictional sample analysis for any upload). If unset, MedLens picks
# whichever provider has an API key (Gemini first).
AI_PROVIDER=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI or any OpenAI-compatible vision endpoint
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model used for text-only work (translation, assistant).
# Defaults to the same model as above.
GEMINI_TEXT_MODEL=
OPENAI_TEXT_MODEL=

# Upload limits
MAX_UPLOAD_MB_PER_FILE=10
MAX_UPLOAD_FILES=8

# Optional extra languages, comma-separated "code:Name:speech-locale"
# e.g. de:German:de-DE,ru:Russian:ru-RU
NEXT_PUBLIC_EXTRA_LANGUAGES=

# ---------------- Read-aloud voices ----------------
# Natural online voices in every language. If unset, MedLens picks whichever
# key exists: GOOGLE_TTS_API_KEY, then GEMINI_API_KEY, then OPENAI_API_KEY.
# "browser" turns online voices off (device voices only).
TTS_PROVIDER=

# Optional: Google Cloud Text-to-Speech key (best coverage for Indian
# languages; separate from the Gemini key, see DEPLOY.md).
GOOGLE_TTS_API_KEY=
# Voice family tried first; falls back to the locale's default voice.
GOOGLE_TTS_VOICE=Chirp3-HD-Kore

# Gemini voice (uses GEMINI_API_KEY). Model falls back automatically if the
# named one is not available.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# OpenAI voice (uses OPENAI_API_KEY)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ---------------- Public site protection ----------------
# Per-visitor hourly limits on AI features. 2 = twice as generous, 0 = off.
RATE_LIMIT_MULTIPLIER=1
